# Keitaro Admin API
KEITARO_BASE_URL=https://your-keitaro.example.com
KEITARO_API_KEY=changeme

# Значения по умолчанию для создаваемых кампаний (ID из Keitaro)
KEITARO_DEFAULT_DOMAIN_ID=1
KEITARO_DEFAULT_GROUP_ID=1
KEITARO_DEFAULT_TRAFFIC_SOURCE_ID=1

# Куда отправлять трафик из выбранной страны
FALLBACK_REDIRECT_URL=https://www.google.com

# PostgreSQL
POSTGRES_USER=keitaro
POSTGRES_PASSWORD=keitaro
POSTGRES_DB=keitaro_wrapper
DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5432/keitaro_wrapper
