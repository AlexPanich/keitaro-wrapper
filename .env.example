# Keitaro Admin API. Ключ задаётся только здесь, в интерфейсе он не запрашивается.
KEITARO_BASE_URL=https://your-keitaro.example.com
KEITARO_API_KEY=changeme

# Необязательные дефолты для формы создаватора (ID из Keitaro), только предвыбирают селекты.
# Пусто или 0 — «не выбрано».
KEITARO_DEFAULT_DOMAIN_ID=
KEITARO_DEFAULT_GROUP_ID=
KEITARO_DEFAULT_TRAFFIC_SOURCE_ID=

# Куда гео-поток редиректит трафик из выбранных стран
FALLBACK_REDIRECT_URL=https://www.google.com

# PostgreSQL. В docker compose DATABASE_URL переопределяется (хост db).
POSTGRES_USER=keitaro
POSTGRES_PASSWORD=keitaro
POSTGRES_DB=keitaro_wrapper
DATABASE_URL=postgresql+asyncpg://keitaro:keitaro@localhost:5432/keitaro_wrapper
